{
  "name": "web-demo-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Runnable, editable versions of Camunda's documentation examples: a BPMN model, the code behind each element, and an optional LLM connection, executed in the browser on the nano wasm engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe": "node tools/probe/index.mjs",
    "eval": "node --import ./tools/eval/register.mjs tools/eval/index.mjs",
    "spike:urban": "node --experimental-strip-types tools/spike-urban-bojtos/demo.ts",
    "budget": "node tools/bundle-budget/check.mjs"
  },
  "dependencies": {
    "@bpmn-io/form-js-viewer": "^1.24.1",
    "@bpmn-io/properties-panel": "^3.48.0",
    "@camunda/design-system": "^0.36.0",
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@monaco-editor/react": "^4.6.0",
    "@nanobpm/bojtos-kit": "^0.6.0",
    "@nanobpm/bojtos-react": "^0.6.0",
    "@nanobpm/engine-wasm": "^0.3.0",
    "bpmn-js": "^17.11.1",
    "bpmn-js-element-templates": "^2.30.0",
    "bpmn-js-properties-panel": "^5.63.0",
    "camunda-bpmn-js-behaviors": "^1.18.0",
    "driver.js": "^1.3.1",
    "feelin": "^7.0.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zeebe-bpmn-moddle": "^1.17.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bpmn-moddle": "^10.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "bpmn-moddle": "^8.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
