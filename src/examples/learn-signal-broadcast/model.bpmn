<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_learn_signal_broadcast" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.36.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:signal id="Signal_AllClear" name="all-clear" />
  <bpmn:process id="learn_signal_broadcast" name="Signal intermediate catch event + broadcast" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Shift begins">
      <bpmn:outgoing>Flow_to_wait</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Event_wait_signal" name="Wait for all-clear">
      <bpmn:incoming>Flow_to_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_to_resume</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1" signalRef="Signal_AllClear" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_resume" name="Resume operations">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="resume-operations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_resume</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_done" name="Back to work">
      <bpmn:incoming>Flow_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_to_wait" sourceRef="StartEvent_1" targetRef="Event_wait_signal" />
    <bpmn:sequenceFlow id="Flow_to_resume" sourceRef="Event_wait_signal" targetRef="Activity_resume" />
    <bpmn:sequenceFlow id="Flow_to_end" sourceRef="Activity_resume" targetRef="Event_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="learn_signal_broadcast">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="255" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_wait_signal_di" bpmnElement="Event_wait_signal">
        <dc:Bounds x="272" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="248" y="255" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_resume_di" bpmnElement="Activity_resume">
        <dc:Bounds x="370" y="190" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_done_di" bpmnElement="Event_done">
        <dc:Bounds x="532" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="510" y="255" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_to_wait_di" bpmnElement="Flow_to_wait">
        <di:waypoint x="218" y="230" />
        <di:waypoint x="272" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_resume_di" bpmnElement="Flow_to_resume">
        <di:waypoint x="308" y="230" />
        <di:waypoint x="370" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_end_di" bpmnElement="Flow_to_end">
        <di:waypoint x="470" y="230" />
        <di:waypoint x="532" y="230" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
