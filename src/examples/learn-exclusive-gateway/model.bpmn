<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_learn_exclusive_gateway" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.36.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="learn_exclusive_gateway" name="Exclusive gateway" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Order placed">
      <bpmn:outgoing>Flow_to_check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_check_order" name="Check order total">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-order-total" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_check</bpmn:incoming>
      <bpmn:outgoing>Flow_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_shipping_route" name="Which shipping route?" default="Flow_to_standard">
      <bpmn:incoming>Flow_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_to_express</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_standard</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_to_express" name="route = &#34;express&#34;" sourceRef="Gateway_shipping_route" targetRef="Activity_express_ship">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=route = "express"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_standard" name="default" sourceRef="Gateway_shipping_route" targetRef="Activity_standard_ship" />
    <bpmn:serviceTask id="Activity_express_ship" name="Express ship">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="express-ship" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_express</bpmn:incoming>
      <bpmn:outgoing>Flow_express_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_standard_ship" name="Standard ship">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="standard-ship" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_standard</bpmn:incoming>
      <bpmn:outgoing>Flow_standard_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_express_done" name="Shipped express">
      <bpmn:incoming>Flow_express_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_standard_done" name="Shipped standard">
      <bpmn:incoming>Flow_standard_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_to_check" sourceRef="StartEvent_1" targetRef="Activity_check_order" />
    <bpmn:sequenceFlow id="Flow_to_gateway" sourceRef="Activity_check_order" targetRef="Gateway_shipping_route" />
    <bpmn:sequenceFlow id="Flow_express_to_end" sourceRef="Activity_express_ship" targetRef="Event_express_done" />
    <bpmn:sequenceFlow id="Flow_standard_to_end" sourceRef="Activity_standard_ship" targetRef="Event_standard_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="learn_exclusive_gateway">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="255" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_check_order_di" bpmnElement="Activity_check_order">
        <dc:Bounds x="240" y="190" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_shipping_route_di" bpmnElement="Gateway_shipping_route" isMarkerVisible="true">
        <dc:Bounds x="395" y="205" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="262" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_express_ship_di" bpmnElement="Activity_express_ship">
        <dc:Bounds x="520" y="90" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_standard_ship_di" bpmnElement="Activity_standard_ship">
        <dc:Bounds x="520" y="270" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_express_done_di" bpmnElement="Event_express_done">
        <dc:Bounds x="682" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="660" y="155" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_standard_done_di" bpmnElement="Event_standard_done">
        <dc:Bounds x="682" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="660" y="335" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_to_check_di" bpmnElement="Flow_to_check">
        <di:waypoint x="188" y="230" />
        <di:waypoint x="240" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_gateway_di" bpmnElement="Flow_to_gateway">
        <di:waypoint x="340" y="230" />
        <di:waypoint x="395" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_express_di" bpmnElement="Flow_to_express">
        <di:waypoint x="420" y="205" />
        <di:waypoint x="420" y="130" />
        <di:waypoint x="520" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_standard_di" bpmnElement="Flow_to_standard">
        <di:waypoint x="420" y="255" />
        <di:waypoint x="420" y="310" />
        <di:waypoint x="520" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_express_to_end_di" bpmnElement="Flow_express_to_end">
        <di:waypoint x="620" y="130" />
        <di:waypoint x="682" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_standard_to_end_di" bpmnElement="Flow_standard_to_end">
        <di:waypoint x="620" y="310" />
        <di:waypoint x="682" y="310" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
